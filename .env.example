# Copy to .env and fill in. Real environment variables override these.

# Where your learning data lives (data/, transcripts/, .app/). Leave unset for
# `my-data/` inside this checkout — gitignored here, so pulling code updates
# never touches your lessons. `npm run init-data -- --dir <path>` moves it and
# rewrites this line for you.
#TUTOR_DATA_DIR=

# Auth for app lessons: a subscription token from `claude setup-token`
# (preferred), or a metered API key. The CLI skills need neither.
#CLAUDE_CODE_OAUTH_TOKEN=
#ANTHROPIC_API_KEY=

# Push the data repo after each lesson commit (off-site backup). 1 = on.
#TUTOR_GIT_PUSH=1
