{
  "name": "tutor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A personal AI tutoring system: deterministic curriculum bookkeeping, fluid teaching.",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start-lesson": "tsx scripts/start-lesson.ts",
    "commit-session": "tsx scripts/commit-session.ts",
    "validate": "tsx scripts/validate.ts",
    "init-data": "tsx scripts/init-data.ts",
    "usage-report": "tsx scripts/usage-report.ts",
    "export-lane": "tsx scripts/export-lane.ts",
    "test": "tsx --test tests/*.test.ts",
    "serve": "tsx server/index.ts",
    "restart": "node scripts/restart.mjs",
    "build:web": "vite build web",
    "build:demo": "vite build web --mode demo",
    "dev:web": "vite web",
    "echo-test": "tsx scripts/echo-test.ts",
    "typecheck": "tsc --noEmit && tsc -p web --noEmit",
    "preview:demo": "vite preview web --mode demo --port 5180 --strictPort",
    "backfill-completed-at": "tsx scripts/backfill-completed-at.ts",
    "unit-summaries": "tsx scripts/unit-summaries.ts",
    "demo:snapshot": "tsx scripts/export-demo-curriculum.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.199",
    "@fastify/static": "^9.1.3",
    "fastify": "^5.9.0",
    "yaml": "^2.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "dompurify": "^3.4.11",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "marked": "^18.0.5",
    "mermaid": "^11.16.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vite": "^8.1.3"
  }
}
