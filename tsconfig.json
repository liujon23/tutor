{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "core/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "server/**/*.ts",
    "web/src/lesson/reconcile.ts",
    "web/src/lesson/audio/text.ts",
    "web/src/lesson/audio/endpoint.ts",
    "web/src/lesson/audio/drive-state.ts",
    "web/src/lesson/audio/diag.ts"
  ]
}
